@using WebApp.Forms;
@model TaskForm

@{
    ViewData["Title"] = "Create";
}

<h1>Add task</h1>

<form method="post" asp-action="Create" asp-controller="Task">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div class="form-group row">
        <label class="col-sm-2 col-form-label" asp-for="Title"></label>
        <div class="col-sm-10">
            <input class="form-control" type="text" asp-for="Title" placeholder="Title" />
        </div>
        <span asp-validation-for="Title" class="text-danger"></span>
    </div>
    <div class="form-group row">
        <div class="col-sm-10">            
            <button class="btn btn-primary" type="submit" asp-action="Create" asp-controller="Task">Create</button>
        </div>
    </div>
</form>