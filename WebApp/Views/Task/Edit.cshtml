@using WebApp.Forms;
@model TaskFormEdit

@{
    ViewData["Title"] = "Edit";
}

<form asp-action="ValidateEdit" asp-controller="Task" method="post">
    <div class="form-group row">
        <label class="col-sm-2 col-form-label" asp-for="Title"></label>
        <div class="col-sm-10">
            <input class="form-control" type="text" asp-for="Title" placeholder="Title" value="@Model.Title" />
        </div>
        <validation-message asp-for="Title" class="text-danger" />
    </div>
    <div class="form-group d-flex flex-row">
        <label class="col-sm-2 col-form-label" asp-for="Done"></label>
        <input type="checkbox" asp-for="Done" checked="@Model.Done" />
        <validation-message asp-for="Done" class="text-danger" />
    </div>
    <div class="form-group row">
        <div class="col-sm-10">
            <input type="hidden" asp-for="Id" value="@Model.Id">
            <button class="btn btn-primary" type="submit" asp-action="ValidateEdit" asp-controller="Task" name="id"
                    value="@Model.Id">Submit
                changes</button>
            </div>
        </div>
    </form>